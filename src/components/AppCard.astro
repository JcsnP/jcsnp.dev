---
import type { AppConfig } from '../config/site';
import AppDestinationIcon from './AppDestinationIcon.astro';
import AppMark from './AppMark.astro';
import Card from './Card.astro';

interface Props {
    app: AppConfig;
}

const { app } = Astro.props;
const hasLinks = Boolean(app.links.website || app.links.appStore || app.links.playStore);
const destinations = [
    { kind: 'website', label: 'Website', href: app.links.website },
    { kind: 'appStore', label: 'App Store', href: app.links.appStore },
    { kind: 'playStore', label: 'Play Store', href: app.links.playStore },
] as const;
---

<Card
    as="article"
    interactive={hasLinks}
    padding="small"
    class="flex h-full flex-row items-center gap-3 sm:gap-4"
>
    <AppMark accent={app.accent} label={app.mark} size="medium" />
    <div class="min-w-0 flex-1">
        <span
            class="text-muted dark:text-muted-dark inline-flex rounded-none bg-black/5 px-2.5 py-0.5 text-xs font-semibold dark:bg-white/7"
        >
            {app.status}
        </span>
        <h3 class="mt-1.5 text-xl font-bold tracking-tight">{app.name}</h3>
        <p class="text-muted dark:text-muted-dark mt-1 text-sm leading-6">{app.summary}</p>
    </div>
    <div
        class="flex shrink-0 flex-col gap-1 border-l border-black/8 pl-3 dark:border-white/8"
        aria-label={`${app.name} destinations`}
    >
        {
            destinations.map((destination) =>
                destination.href ? (
                    <a
                        href={destination.href}
                        target="_blank"
                        rel="noreferrer"
                        class="text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark inline-flex size-8 items-center justify-center rounded-none bg-black/5 transition hover:-translate-y-0.5 hover:bg-black/10 dark:bg-white/7 dark:hover:bg-white/12"
                        aria-label={`Open ${app.name} on ${destination.label}`}
                        title={destination.label}
                    >
                        <AppDestinationIcon kind={destination.kind} />
                    </a>
                ) : (
                    <span
                        class="text-muted dark:text-muted-dark inline-flex size-8 cursor-not-allowed items-center justify-center rounded-none bg-black/5 opacity-30 dark:bg-white/7"
                        aria-label={`${destination.label} link unavailable`}
                        title={`${destination.label} unavailable`}
                    >
                        <AppDestinationIcon kind={destination.kind} />
                    </span>
                ),
            )
        }
    </div>
</Card>
