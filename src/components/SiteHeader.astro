---
import { routes, siteConfig } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header
    class="bg-canvas/85 dark:bg-canvas-dark/85 sticky top-0 z-50 border-b border-black/5 backdrop-blur-xl dark:border-white/5"
>
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
        <a
            href={routes.home}
            class="rounded-none text-lg font-extrabold tracking-tight"
            aria-label="jcsnp home"
        >
            jcsnp<span class="text-accent">.</span>
        </a>
        <div class="flex items-center gap-2 sm:gap-4">
            <nav aria-label="Main navigation">
                <ul class="flex items-center gap-1">
                    {
                        siteConfig.navigation.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark rounded-none px-3 py-2 text-sm font-semibold transition hover:bg-black/5 dark:hover:bg-white/5"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
            <ThemeToggle />
        </div>
    </div>
</header>
