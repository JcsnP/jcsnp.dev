---
type CardElement = 'article' | 'div' | 'section';

interface Props {
    as?: CardElement;
    href?: string;
    variant?: 'surface' | 'subtle' | 'inverse';
    radius?: 'medium' | 'large' | 'frame';
    padding?: 'none' | 'small' | 'compact' | 'medium' | 'large' | 'frame';
    interactive?: boolean;
    ariaLabel?: string;
    rel?: string;
    class?: string;
}

const props = Astro.props as Props;

const {
    as: Tag = 'div',
    href,
    variant = 'surface',
    radius = 'medium',
    padding = 'medium',
    interactive = Boolean(props.href),
    ariaLabel,
    rel,
    class: className,
} = props;

const variantClasses = {
    surface:
        'border border-black/10 bg-surface shadow-sm hover:border-black/25 hover:bg-white dark:border-white/10 dark:bg-surface-dark dark:hover:border-white/25 dark:hover:bg-[#1a1a1a]',
    subtle: 'border border-transparent bg-black/[0.045] hover:border-black/15 hover:bg-black/[0.07] dark:bg-white/[0.05] dark:hover:border-white/15 dark:hover:bg-white/[0.08]',
    inverse:
        'border border-white/10 bg-ink text-white hover:border-white/25 hover:bg-[#1b1b1b] dark:bg-surface-dark dark:text-white dark:hover:border-white/25 dark:hover:bg-[#1a1a1a]',
};
const radiusClasses = {
    medium: 'rounded-2xl',
    large: 'rounded-3xl',
    frame: 'rounded-[2.5rem]',
};
const paddingClasses = {
    none: '',
    small: 'p-4',
    compact: 'p-5',
    medium: 'p-6',
    large: 'p-8 sm:p-12',
    frame: 'p-4',
};
const interactiveClasses = interactive
    ? 'transition-[background-color,border-color,box-shadow,transform] duration-500 hover:-translate-y-1 hover:shadow-xl'
    : '';
const classes = [
    variantClasses[variant],
    radiusClasses[radius],
    paddingClasses[padding],
    interactiveClasses,
    className,
];
---

{
    href ? (
        <a href={href} rel={rel} class:list={classes} aria-label={ariaLabel}>
            <slot />
        </a>
    ) : (
        <Tag class:list={classes} aria-label={ariaLabel}>
            <slot />
        </Tag>
    )
}
