---
import { Image } from 'astro:assets';

interface Props {
    accent: string;
    label: string;
    icon?: {
        light: import('astro').ImageMetadata;
        dark: import('astro').ImageMetadata;
    };
    iconAlt?: string;
    size?: 'small' | 'medium' | 'large';
}

const { accent, label, icon, iconAlt, size = 'small' } = Astro.props;
const dimensions = {
    small: 'size-14 rounded-none text-xl',
    medium: 'size-16 rounded-none text-xl',
    large: 'size-24 rounded-none text-4xl',
}[size];
---

{
    icon ? (
        <div class:list={[dimensions, 'shrink-0 overflow-hidden shadow-lg']}>
            <Image
                src={icon.light}
                alt={`${iconAlt ?? label} app icon`}
                width="128"
                height="128"
                format="webp"
                quality="high"
                class="block size-full object-cover dark:hidden"
            />
            <Image
                src={icon.dark}
                alt=""
                width="128"
                height="128"
                format="webp"
                quality="high"
                class="hidden size-full object-cover dark:block"
            />
        </div>
    ) : (
        <div
            class:list={[
                dimensions,
                'grid shrink-0 place-items-center font-extrabold text-white shadow-lg',
            ]}
            style={`background: linear-gradient(145deg, color-mix(in srgb, ${accent} 30%, #1b1b1b), #080808);`}
            aria-hidden="true"
        >
            {label}
        </div>
    )
}
