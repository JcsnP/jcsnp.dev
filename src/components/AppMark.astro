---
interface Props {
    accent: string;
    label: string;
    size?: 'small' | 'medium' | 'large';
}

const { accent, label, size = 'small' } = Astro.props;
const dimensions = {
    small: 'size-14 rounded-2xl text-xl',
    medium: 'size-16 rounded-2xl text-xl',
    large: 'size-24 rounded-[1.75rem] text-4xl',
}[size];
---

<div
    class:list={[
        dimensions,
        'grid shrink-0 place-items-center font-extrabold text-white shadow-lg',
    ]}
    style={`background: linear-gradient(145deg, ${accent}, color-mix(in srgb, ${accent} 65%, #161532));`}
    aria-hidden="true"
>
    {label}
</div>
