---
interface Props {
    kind: 'website' | 'appStore' | 'playStore';
}

const { kind } = Astro.props;
---

{
    kind === 'website' ? (
        <svg viewBox="0 0 24 24" fill="none" class="size-4.5" aria-hidden="true">
            <path
                d="M7 17 17 7m-7 0h7v7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            />
        </svg>
    ) : kind === 'appStore' ? (
        <svg viewBox="0 0 24 24" class="size-4.5" aria-hidden="true">
            <path
                fill="currentColor"
                d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.25-.07 2.12.69 2.85.75 1.09-.22 2.13-.85 3.3-.76 1.4.11 2.45.66 3.15 1.64-2.89 1.73-2.2 5.54.44 6.6-.42 1.1-.97 2.19-1.74 3.04ZM12.03 7.25c-.15-1.63 1.21-2.98 2.73-3.11.21 1.89-1.72 3.3-2.73 3.11Z"
            />
        </svg>
    ) : (
        <svg viewBox="0 0 24 24" fill="none" class="size-4.5" aria-hidden="true">
            <path
                d="m5 4 14 8L5 20V4Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
            />
        </svg>
    )
}
