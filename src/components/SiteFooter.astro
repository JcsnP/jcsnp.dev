---
import { siteConfig } from '../config/site';
---

<footer class="border-t border-black/5 dark:border-white/5">
    <div
        class="text-muted dark:text-muted-dark mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8"
    >
        <p>© {new Date().getFullYear()} {siteConfig.author.fullName}</p>
        <p>Designed and built by {siteConfig.author.alias}.</p>
    </div>
</footer>
