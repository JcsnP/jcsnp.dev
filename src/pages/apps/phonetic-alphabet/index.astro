---
import AppMark from '../../../components/AppMark.astro';
import Button from '../../../components/Button.astro';
import Card from '../../../components/Card.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getApp, routes } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const app = getApp('phonetic-alphabet');
const title = `${app.name} — ${app.platform} app`;
---

<BaseLayout {title} description={app.summary}>
    <SiteHeader />
    <main>
        <section class="relative overflow-hidden">
            <div
                class="absolute inset-0 -z-10 opacity-70"
                style={`background: radial-gradient(circle at 65% 30%, color-mix(in srgb, ${app.accent} 22%, transparent), transparent 42%);`}
            >
            </div>
            <div
                class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-[1fr_0.8fr] lg:py-36"
            >
                <div>
                    <div class="flex items-center gap-5">
                        <AppMark accent={app.accent} size="large" />
                        <div>
                            <p class="text-accent font-bold">{app.platform}</p>
                            <p class="text-muted dark:text-muted-dark text-sm">{app.status}</p>
                        </div>
                    </div>
                    <h1 class="mt-8 text-5xl font-extrabold tracking-[-0.04em] sm:text-7xl">
                        {app.name}
                    </h1>
                    <p class="text-muted dark:text-muted-dark mt-6 max-w-xl text-xl leading-8">
                        A focused new iOS experience currently taking shape. More product details
                        will be shared as the app gets closer to release.
                    </p>
                    <Button
                        variant="secondary"
                        disabled
                        class="mt-9"
                        aria-label="App Store availability: coming soon"
                    >
                        App Store · Coming soon
                    </Button>
                </div>
                <Card radius="frame" padding="frame" class="mx-auto w-full max-w-sm shadow-2xl">
                    <div
                        class="aspect-[9/16] rounded-[1.8rem] p-8 text-white"
                        style={`background: linear-gradient(155deg, ${app.accent}, #17162b 72%);`}
                    >
                        <p class="text-sm font-bold tracking-widest uppercase opacity-70">
                            Preview
                        </p>
                        <div class="mt-20 text-center">
                            <p class="text-7xl font-extrabold">A</p>
                            <p class="mt-3 text-2xl font-bold">Alpha</p>
                            <p class="mt-2 opacity-70">Mock app screen</p>
                        </div>
                    </div>
                </Card>
            </div>
        </section>

        <section class="border-y border-black/5 dark:border-white/5">
            <div class="mx-auto grid max-w-6xl gap-5 px-5 py-20 sm:grid-cols-3 sm:px-8">
                {
                    [
                        [
                            'Clear by design',
                            'A simple interface concept centered on quick, understandable information.',
                        ],
                        [
                            'Made for iOS',
                            'A native mobile project designed with the iPhone experience in mind.',
                        ],
                        [
                            'Work in progress',
                            'The feature set and release details will be published when they are ready.',
                        ],
                    ].map(([heading, copy]) => (
                        <Card as="article" variant="subtle">
                            <h2 class="text-xl font-bold">{heading}</h2>
                            <p class="text-muted dark:text-muted-dark mt-3 leading-7">{copy}</p>
                        </Card>
                    ))
                }
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
            <Card
                as="section"
                variant="inverse"
                radius="large"
                padding="large"
                class="sm:flex sm:items-center sm:justify-between"
            >
                <div>
                    <h2 class="text-3xl font-extrabold">The important details.</h2>
                    <p class="mt-3 text-white/65">
                        Read the current mock legal documents for this app.
                    </p>
                </div>
                <div class="mt-7 flex flex-wrap gap-3 sm:mt-0">
                    <Button href={routes.privacyPolicy(app.slug)} variant="inverse" size="small"
                        >Privacy policy</Button
                    >
                    <Button
                        href={routes.termsOfService(app.slug)}
                        variant="inverse-outline"
                        size="small">Terms of service</Button
                    >
                </div>
            </Card>
        </section>
    </main>
    <SiteFooter />
</BaseLayout>
