---
import SiteFooter from '../../../../components/SiteFooter.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import { getApp, routes } from '../../../../config/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const app = getApp('phonetic-alphabet');
const title = `Privacy Policy — ${app.name}`;
const description = `Privacy policy for the ${app.name} iOS application.`;
---

<BaseLayout {title} {description}>
    <SiteHeader />
    <main class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
        <a href={routes.app(app.slug)} class="text-accent font-bold">← Back to {app.name}</a>
        <article class="mt-10">
            <p class="text-accent text-sm font-bold tracking-widest uppercase">Mock document</p>
            <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Privacy Policy</h1>
            <p class="text-muted dark:text-muted-dark mt-4">Last updated: August 29, 2026</p>
            <div class="text-muted dark:text-muted-dark mt-10 space-y-9 text-lg leading-8">
                <p
                    class="text-ink dark:text-ink-dark rounded-2xl border border-amber-500/20 bg-amber-500/10 p-5 text-base"
                >
                    This is placeholder content for an unreleased application. It must be reviewed
                    and replaced before production use.
                </p>
                <section>
                    <h2 class="text-ink dark:text-ink-dark text-2xl font-bold">
                        Information collection
                    </h2>
                    <p class="mt-3">
                        The current mock version describes an application that does not collect
                        personal information. The final policy will reflect the application’s actual
                        behavior and included services.
                    </p>
                </section>
                <section>
                    <h2 class="text-ink dark:text-ink-dark text-2xl font-bold">
                        Third-party services
                    </h2>
                    <p class="mt-3">
                        If third-party services are introduced, this policy will identify those
                        providers and explain how they handle information.
                    </p>
                </section>
                <section>
                    <h2 class="text-ink dark:text-ink-dark text-2xl font-bold">Changes</h2>
                    <p class="mt-3">
                        This policy may be updated as the application develops. The revision date on
                        this page will identify the latest version.
                    </p>
                </section>
                <section>
                    <h2 class="text-ink dark:text-ink-dark text-2xl font-bold">Contact</h2>
                    <p class="mt-3">
                        A verified support contact will be published before the application is
                        released.
                    </p>
                </section>
            </div>
        </article>
    </main>
    <SiteFooter />
</BaseLayout>
