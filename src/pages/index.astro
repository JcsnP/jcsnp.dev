---
import AppCard from '../components/AppCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { routes, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <SiteHeader />
    <main>
        <section class="relative isolate overflow-hidden">
            <div
                class="absolute inset-x-0 top-0 -z-10 mx-auto h-[32rem] max-w-5xl rounded-full bg-[radial-gradient(circle,rgba(108,99,255,0.18),transparent_67%)] blur-2xl"
            >
            </div>
            <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32 lg:py-40">
                <div class="max-w-3xl">
                    <p
                        class="border-accent/20 bg-accent-soft text-accent dark:bg-accent/15 mb-5 inline-flex rounded-full border px-4 py-2 text-sm font-bold"
                    >
                        Software developer · Mobile app maker
                    </p>
                    <h1
                        class="text-5xl leading-[1.04] font-extrabold tracking-[-0.045em] sm:text-7xl"
                    >
                        Hello, I’m <span class="text-accent">jcsnp</span>.<br />I build useful
                        digital things.
                    </h1>
                    <p
                        class="text-muted dark:text-muted-dark mt-8 max-w-2xl text-lg leading-8 sm:text-xl"
                    >
                        I’m {siteConfig.author.fullName}, a software developer creating thoughtful
                        mobile applications and web experiences.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href={routes.appsSection}
                            class="bg-ink dark:text-ink rounded-xl px-5 py-3 font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl dark:bg-white"
                        >
                            View my apps
                        </a>
                        <a
                            href={routes.links}
                            class="rounded-xl border border-black/10 bg-white/70 px-5 py-3 font-bold transition hover:-translate-y-0.5 hover:bg-white dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
                        >
                            All links
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section id="apps" class="scroll-mt-24 border-t border-black/5 dark:border-white/5">
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
                <div class="max-w-2xl">
                    <p class="text-accent text-sm font-bold tracking-widest uppercase">Apps</p>
                    <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
                        Projects with a place of their own.
                    </h2>
                    <p class="text-muted dark:text-muted-dark mt-4 text-lg leading-8">
                        Each application has its own page, updates, and clearly linked legal
                        information.
                    </p>
                </div>
                <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {siteConfig.apps.map((app) => <AppCard app={app} />)}
                </div>
            </div>
        </section>
    </main>
    <SiteFooter />
</BaseLayout>
