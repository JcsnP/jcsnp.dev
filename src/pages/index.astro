---
import AppCard from '../components/AppCard.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SoloDevNotice from '../components/SoloDevNotice.astro';
import { routes, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <SiteHeader />
    <main>
        <section class="relative overflow-hidden border-b border-black/10 dark:border-white/10">
            <div
                class="absolute inset-0 -z-10 opacity-70 dark:opacity-35"
                style="background: radial-gradient(circle at 82% 36%, color-mix(in srgb, #ffffff 52%, transparent), transparent 31%);"
            >
            </div>
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28 lg:py-32">
                <div
                    class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16 xl:grid-cols-[minmax(0,1fr)_26rem]"
                >
                    <div class="max-w-3xl">
                        <p class="text-accent text-xs font-bold tracking-[0.22em] uppercase">
                            Independent software developer
                        </p>
                        <h1
                            class="mt-5 max-w-2xl text-5xl leading-[0.94] font-extrabold tracking-[-0.065em] sm:text-6xl lg:text-7xl"
                        >
                            A software engineer building clear, useful digital products.
                        </h1>
                        <p
                            class="text-muted dark:text-muted-dark mt-7 max-w-xl text-lg leading-8 sm:text-xl"
                        >
                            I’m {siteConfig.author.fullName}, making thoughtful mobile apps and web
                            experiences with attention to the details that make software feel good.
                        </p>
                        <div class="mt-9 flex flex-wrap gap-3">
                            <Button href={routes.appsSection}>View my apps</Button>
                        </div>
                    </div>
                    <div class="mx-auto hidden w-full max-w-[360px] lg:block">
                        <img
                            src={`${routes.home}assets/memoji/greeting.png`}
                            alt={`Greeting Memoji of ${siteConfig.author.fullName}`}
                            width="259"
                            height="280"
                            class="mx-auto block w-[88%] object-contain"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="border-b border-black/10 dark:border-white/10">
            <div class="mx-auto grid max-w-6xl gap-5 px-5 py-20 sm:grid-cols-3 sm:px-8">
                {
                    [
                        [
                            'Thoughtful by default',
                            'Simple choices, clear structure, and purposeful details shape every project.',
                        ],
                        [
                            'Made to be useful',
                            'Ideas become focused products designed around real tasks and everyday needs.',
                        ],
                        [
                            'Always evolving',
                            'Each release is a chance to listen, learn, refine, and make the experience better.',
                        ],
                    ].map(([heading, copy]) => (
                        <Card as="article" variant="subtle">
                            <h2 class="text-xl font-bold">{heading}</h2>
                            <p class="text-muted dark:text-muted-dark mt-3 leading-7">{copy}</p>
                        </Card>
                    ))
                }
            </div>
        </section>

        <section id="apps" class="scroll-mt-24">
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
                <div class="max-w-2xl">
                    <p class="text-accent text-sm font-bold tracking-[0.22em] uppercase">
                        Selected work
                    </p>
                    <h2 class="mt-3 text-3xl font-extrabold tracking-[-0.03em] sm:text-4xl">
                        A home for everything I make.
                    </h2>
                    <p class="text-muted dark:text-muted-dark mt-4 text-lg leading-8">
                        Explore the apps I’m building, then visit their official websites or store
                        listings when they become available.
                    </p>
                </div>
                <div class="mt-10 grid gap-4">
                    {siteConfig.apps.map((app) => <AppCard app={app} />)}
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8 sm:pb-28">
            <Card
                as="section"
                variant="inverse"
                radius="large"
                padding="large"
                class="sm:flex sm:items-center sm:justify-between"
            >
                <div>
                    <h2 class="text-3xl font-extrabold">Find everything in one place.</h2>
                    <p class="mt-3 text-white/65">
                        Browse the portfolio, apps, and external destinations from the link hub.
                    </p>
                </div>
                <Button href={routes.links} variant="inverse" class="mt-7 sm:mt-0">
                    View all links
                </Button>
            </Card>
        </section>
    </main>
    <SiteFooter />
    <SoloDevNotice />
</BaseLayout>
