---
import AppCard from '../components/AppCard.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SoloDevNotice from '../components/SoloDevNotice.astro';
import { routes, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <SiteHeader />
    <main>
        <section class="relative overflow-hidden border-b border-black/10 dark:border-white/10">
            <div
                class="absolute inset-0 -z-10 opacity-70"
                style="background: radial-gradient(circle at 78% 24%, color-mix(in srgb, #ffffff 10%, transparent), transparent 34%);"
            >
            </div>
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28 lg:py-36">
                <div
                    class="flex flex-col gap-10 xl:flex-row xl:items-end xl:justify-between xl:gap-0"
                >
                    <div class="max-w-5xl xl:min-w-0 xl:flex-1">
                        <div class="flex items-center gap-4">
                            <div
                                class="size-16 shrink-0 overflow-hidden rounded-none border border-black/15 shadow-lg sm:size-20 dark:border-white/15"
                                aria-hidden="true"
                            >
                                <img
                                    src={`${routes.home}assets/images/logo/light.png`}
                                    alt=""
                                    width="512"
                                    height="512"
                                    class="block size-full object-cover dark:hidden"
                                />
                                <img
                                    src={`${routes.home}assets/images/logo/dark.png`}
                                    alt=""
                                    width="512"
                                    height="512"
                                    class="hidden size-full object-cover dark:block"
                                />
                            </div>
                            <div class="border-l border-black/15 pl-4 dark:border-white/15">
                                <p
                                    class="text-accent text-xs font-bold tracking-[0.22em] uppercase"
                                >
                                    Software developer
                                </p>
                                <p class="text-muted dark:text-muted-dark mt-1 text-sm">
                                    {siteConfig.author.fullName}
                                </p>
                            </div>
                        </div>
                        <h1
                            class="hero-name mt-10 text-[clamp(4.5rem,16vw,11rem)] leading-[0.82] font-extrabold tracking-[-0.09em]"
                            aria-label={siteConfig.author.alias}
                        >
                            {
                                siteConfig.author.alias.split('').map((character, index) => (
                                    <span
                                        aria-hidden="true"
                                        class="hero-name__letter"
                                        style={`--letter-index: ${index}`}
                                    >
                                        {character}
                                    </span>
                                ))
                            }
                        </h1>
                        <p
                            class="text-muted dark:text-muted-dark mt-8 max-w-2xl text-lg leading-8 sm:text-xl"
                        >
                            I create thoughtful mobile applications and web experiences, with a
                            focus on clarity, usefulness, and the details that make software feel
                            good.
                        </p>
                        <div class="mt-9 flex flex-wrap gap-3">
                            <Button href={routes.appsSection}>View my apps</Button>
                        </div>
                    </div>
                    <img
                        src={`${routes.home}assets/memoji/greeting.png`}
                        alt={`Greeting Memoji of ${siteConfig.author.fullName}`}
                        width="259"
                        height="280"
                        class="w-full max-w-[384px] self-end object-contain xl:w-[384px] xl:shrink-0"
                    />
                </div>
            </div>
        </section>

        <section class="border-b border-black/10 dark:border-white/10">
            <div class="mx-auto grid max-w-6xl gap-5 px-5 py-20 sm:grid-cols-3 sm:px-8">
                {
                    [
                        [
                            'Thoughtful by default',
                            'Simple choices, clear structure, and purposeful details shape every project.',
                        ],
                        [
                            'Made to be useful',
                            'Ideas become focused products designed around real tasks and everyday needs.',
                        ],
                        [
                            'Always evolving',
                            'Each release is a chance to listen, learn, refine, and make the experience better.',
                        ],
                    ].map(([heading, copy]) => (
                        <Card as="article" variant="subtle">
                            <h2 class="text-xl font-bold">{heading}</h2>
                            <p class="text-muted dark:text-muted-dark mt-3 leading-7">{copy}</p>
                        </Card>
                    ))
                }
            </div>
        </section>

        <section id="apps" class="scroll-mt-24">
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
                <div class="max-w-2xl">
                    <p class="text-accent text-sm font-bold tracking-[0.22em] uppercase">
                        Selected work
                    </p>
                    <h2 class="mt-3 text-3xl font-extrabold tracking-[-0.03em] sm:text-4xl">
                        A home for everything I make.
                    </h2>
                    <p class="text-muted dark:text-muted-dark mt-4 text-lg leading-8">
                        Explore the apps I’m building, then visit their official websites or store
                        listings when they become available.
                    </p>
                </div>
                <div class="mt-10 grid gap-4">
                    {siteConfig.apps.map((app) => <AppCard app={app} />)}
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8 sm:pb-28">
            <Card
                as="section"
                variant="inverse"
                radius="large"
                padding="large"
                class="sm:flex sm:items-center sm:justify-between"
            >
                <div>
                    <h2 class="text-3xl font-extrabold">Find everything in one place.</h2>
                    <p class="mt-3 text-white/65">
                        Browse the portfolio, apps, and external destinations from the link hub.
                    </p>
                </div>
                <Button href={routes.links} variant="inverse" class="mt-7 sm:mt-0">
                    View all links
                </Button>
            </Card>
        </section>
    </main>
    <SiteFooter />
    <SoloDevNotice />
</BaseLayout>

<style>
    .hero-name__letter {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.35em);
        animation: hero-name-letter 650ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: calc(var(--letter-index) * 90ms);
    }

    @keyframes hero-name-letter {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-name__letter {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }
</style>
