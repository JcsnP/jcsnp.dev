---
import AppCard from '../components/AppCard.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SoloDevNotice from '../components/SoloDevNotice.astro';
import { routes, siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <SiteHeader />
    <main>
        <section class="relative overflow-hidden">
            <div
                class="absolute inset-0 -z-10 opacity-70"
                style="background: radial-gradient(circle at 65% 30%, color-mix(in srgb, #6c63ff 22%, transparent), transparent 42%);"
            >
            </div>
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28 lg:py-36">
                <div>
                    <div class="flex items-center gap-5">
                        <div
                            class="grid size-24 place-items-center rounded-[1.75rem] bg-[linear-gradient(145deg,#6c63ff,#252244)] text-3xl font-extrabold text-white shadow-lg"
                            aria-hidden="true"
                        >
                            jc
                        </div>
                        <div>
                            <p class="text-accent font-bold">Software developer</p>
                            <p class="text-muted dark:text-muted-dark text-sm">
                                {siteConfig.author.fullName}
                            </p>
                        </div>
                    </div>
                    <h1
                        class="hero-name mt-8 text-5xl font-extrabold tracking-[-0.04em] sm:text-7xl"
                        aria-label={siteConfig.author.alias}
                    >
                        {
                            siteConfig.author.alias.split('').map((character, index) => (
                                <span
                                    aria-hidden="true"
                                    class="hero-name__letter"
                                    style={`--letter-index: ${index}`}
                                >
                                    {character}
                                </span>
                            ))
                        }
                    </h1>
                    <p class="text-muted dark:text-muted-dark mt-6 max-w-4xl text-xl leading-8">
                        I create thoughtful mobile applications and web experiences, with a focus on
                        clarity, usefulness, and the details that make software feel good.
                    </p>
                    <div class="mt-9 flex flex-wrap gap-3">
                        <Button href={routes.appsSection}>View my apps</Button>
                    </div>
                </div>
            </div>
        </section>

        <section class="border-y border-black/5 dark:border-white/5">
            <div class="mx-auto grid max-w-6xl gap-5 px-5 py-20 sm:grid-cols-3 sm:px-8">
                {
                    [
                        [
                            'Thoughtful by default',
                            'Simple choices, clear structure, and purposeful details shape every project.',
                        ],
                        [
                            'Made to be useful',
                            'Ideas become focused products designed around real tasks and everyday needs.',
                        ],
                        [
                            'Always evolving',
                            'Each release is a chance to listen, learn, refine, and make the experience better.',
                        ],
                    ].map(([heading, copy]) => (
                        <Card as="article" variant="subtle">
                            <h2 class="text-xl font-bold">{heading}</h2>
                            <p class="text-muted dark:text-muted-dark mt-3 leading-7">{copy}</p>
                        </Card>
                    ))
                }
            </div>
        </section>

        <section id="apps" class="scroll-mt-24">
            <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
                <div class="max-w-2xl">
                    <p class="text-accent text-sm font-bold tracking-widest uppercase">Apps</p>
                    <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
                        A home for everything I make.
                    </h2>
                    <p class="text-muted dark:text-muted-dark mt-4 text-lg leading-8">
                        Explore the apps I’m building, then visit their official websites or store
                        listings when they become available.
                    </p>
                </div>
                <div class="mt-10 grid gap-4">
                    {siteConfig.apps.map((app) => <AppCard app={app} />)}
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8 sm:pb-28">
            <Card
                as="section"
                variant="inverse"
                radius="large"
                padding="large"
                class="sm:flex sm:items-center sm:justify-between"
            >
                <div>
                    <h2 class="text-3xl font-extrabold">Find everything in one place.</h2>
                    <p class="mt-3 text-white/65">
                        Browse the portfolio, apps, and external destinations from the link hub.
                    </p>
                </div>
                <Button href={routes.links} variant="inverse" class="mt-7 sm:mt-0">
                    View all links
                </Button>
            </Card>
        </section>
    </main>
    <SiteFooter />
    <SoloDevNotice />
</BaseLayout>

<style>
    .hero-name__letter {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.35em);
        animation: hero-name-letter 650ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: calc(var(--letter-index) * 90ms);
    }

    @keyframes hero-name-letter {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-name__letter {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }
</style>
