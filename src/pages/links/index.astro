---
import AppCard from '../../components/AppCard.astro';
import Card from '../../components/Card.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { routes, siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = `Links — ${siteConfig.author.alias}`;
const description = `Portfolio, applications, and official links from ${siteConfig.author.fullName}.`;
const memojiImages = ['thumbs-up.png', 'working.png'].map(
    (filename) => `${routes.home}assets/memoji/${filename}`,
);
---

<BaseLayout {title} {description}>
    <SiteHeader />
    <main class="mx-auto min-h-[calc(100vh-9rem)] max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
        <header class="text-center">
            <img
                id="memoji"
                src={memojiImages[0]}
                alt={`Memoji portrait of ${siteConfig.author.fullName}`}
                width="259"
                height="280"
                class="mx-auto h-32 w-auto object-contain sm:h-40"
                data-memoji-sources={memojiImages.join(',')}
            />
            <p class="text-muted dark:text-muted-dark mt-6 text-lg">
                {siteConfig.author.fullName} · Software developer
            </p>
        </header>

        <section class="mt-12" aria-labelledby="explore-links">
            <h2
                id="explore-links"
                class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
            >
                Explore
            </h2>
            <div class="mt-3 grid gap-3">
                <Card href={routes.home} padding="compact">
                    <span class="font-bold">Portfolio</span>
                    <span class="text-muted dark:text-muted-dark mt-1 block text-sm"
                        >About me and the projects I’m building.</span
                    >
                </Card>
            </div>
        </section>

        {
            siteConfig.apps.length > 0 && (
                <section class="mt-10" aria-labelledby="app-links">
                    <h2
                        id="app-links"
                        class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
                    >
                        Apps
                    </h2>
                    <div class="mt-3 grid gap-3">
                        {siteConfig.apps.map((app) => (
                            <AppCard app={app} />
                        ))}
                    </div>
                </section>
            )
        }

        {
            siteConfig.profiles.length > 0 && (
                <section class="mt-10" aria-labelledby="profile-links">
                    <h2
                        id="profile-links"
                        class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
                    >
                        Elsewhere
                    </h2>
                    <div class="mt-3 grid gap-3">
                        {siteConfig.profiles.map((profile) => (
                            <Card
                                href={profile.href}
                                rel={profile.external ? 'me noreferrer noopener' : undefined}
                                target={profile.external ? '_blank' : undefined}
                                padding="compact"
                                class="flex items-center justify-between gap-4 font-bold"
                            >
                                <span class="inline-flex items-center gap-3">
                                    {profile.icon === 'x' && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="size-5 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.258 2.25H8.084l4.713 6.231 5.447-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
                                            />
                                        </svg>
                                    )}
                                    {profile.icon === 'github' && (
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="size-5 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.73.084-.73 1.205.085 1.838 1.237 1.838 1.237 1.07 1.834 2.809 1.304 3.495.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.435.375.81 1.096.81 2.21 0 1.595-.015 2.88-.015 3.27 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                                            />
                                        </svg>
                                    )}
                                    {profile.label}
                                </span>
                                {profile.external && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        class="text-muted dark:text-muted-dark size-5 shrink-0"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="M5 19 19 5m0 0H9m10 0v10"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                )}
                            </Card>
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <SiteFooter />
</BaseLayout>

<script>
    const memoji = document.querySelector<HTMLImageElement>('#memoji');
    const sources = memoji?.dataset.memojiSources?.split(',').filter(Boolean) ?? [];

    if (memoji && sources.length > 0) {
        memoji.src = sources[Math.floor(Math.random() * sources.length)];
    }
</script>
