---
import AppMark from '../../components/AppMark.astro';
import Card from '../../components/Card.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { routes, siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = `Links — ${siteConfig.author.alias}`;
const description = `Portfolio, applications, and official links from ${siteConfig.author.fullName}.`;
---

<BaseLayout {title} {description}>
    <SiteHeader />
    <main class="mx-auto min-h-[calc(100vh-9rem)] max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
        <header class="text-center">
            <div
                class="bg-ink dark:text-ink mx-auto grid size-20 place-items-center rounded-3xl text-2xl font-extrabold text-white shadow-xl dark:bg-white"
            >
                jc
            </div>
            <h1 class="mt-6 text-4xl font-extrabold tracking-tight">{siteConfig.author.alias}</h1>
            <p class="text-muted dark:text-muted-dark mt-3 text-lg">
                {siteConfig.author.fullName} · Software developer
            </p>
        </header>

        <section class="mt-12" aria-labelledby="site-links">
            <h2
                id="site-links"
                class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
            >
                Explore
            </h2>
            <div class="mt-3 grid gap-3">
                <Card href={routes.home} padding="compact">
                    <span class="font-bold">Portfolio</span>
                    <span class="text-muted dark:text-muted-dark mt-1 block text-sm"
                        >About me and the projects I’m building.</span
                    >
                </Card>
                {
                    siteConfig.apps.map((app) => (
                        <Card as="article" padding="compact">
                            <a
                                href={routes.app(app.slug)}
                                class="flex items-center gap-4 rounded-xl"
                            >
                                <AppMark accent={app.accent} />
                                <span class="min-w-0 flex-1">
                                    <span class="block font-bold">{app.name}</span>
                                    <span class="text-muted dark:text-muted-dark mt-1 block text-sm">
                                        {app.platform} · {app.status}
                                    </span>
                                </span>
                                <span aria-hidden="true">→</span>
                            </a>
                            <div class="mt-4 flex flex-wrap gap-2 border-t border-black/5 pt-4 dark:border-white/5">
                                <a
                                    href={routes.privacyPolicy(app.slug)}
                                    class="text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-black/5 dark:hover:bg-white/5"
                                >
                                    Privacy policy
                                </a>
                                <a
                                    href={routes.termsOfService(app.slug)}
                                    class="text-muted hover:text-ink dark:text-muted-dark dark:hover:text-ink-dark rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-black/5 dark:hover:bg-white/5"
                                >
                                    Terms of service
                                </a>
                            </div>
                        </Card>
                    ))
                }
            </div>
        </section>

        {
            siteConfig.profiles.length > 0 && (
                <section class="mt-10" aria-labelledby="profile-links">
                    <h2
                        id="profile-links"
                        class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
                    >
                        Elsewhere
                    </h2>
                    <div class="mt-3 grid gap-3">
                        {siteConfig.profiles.map((profile) => (
                            <Card
                                href={profile.href}
                                rel={profile.external ? 'me noreferrer' : undefined}
                                padding="compact"
                                class="font-bold"
                            >
                                {profile.label}
                            </Card>
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <SiteFooter />
</BaseLayout>
