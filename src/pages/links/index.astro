---
import AppCard from '../../components/AppCard.astro';
import Card from '../../components/Card.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { routes, siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = `Links — ${siteConfig.author.alias}`;
const description = `Portfolio, applications, and official links from ${siteConfig.author.fullName}.`;
---

<BaseLayout {title} {description}>
    <SiteHeader />
    <main class="mx-auto min-h-[calc(100vh-9rem)] max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
        <header class="text-center">
            <div
                class="bg-ink dark:text-ink mx-auto grid size-20 place-items-center rounded-3xl text-2xl font-extrabold text-white shadow-xl dark:bg-white"
            >
                jc
            </div>
            <h1 class="mt-6 text-4xl font-extrabold tracking-tight">{siteConfig.author.alias}</h1>
            <p class="text-muted dark:text-muted-dark mt-3 text-lg">
                {siteConfig.author.fullName} · Software developer
            </p>
        </header>

        <section class="mt-12" aria-labelledby="site-links">
            <h2
                id="site-links"
                class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
            >
                Explore
            </h2>
            <div class="mt-3 grid gap-3">
                <Card href={routes.home} padding="compact">
                    <span class="font-bold">Portfolio</span>
                    <span class="text-muted dark:text-muted-dark mt-1 block text-sm"
                        >About me and the projects I’m building.</span
                    >
                </Card>
                {siteConfig.apps.map((app) => <AppCard app={app} />)}
            </div>
        </section>

        {
            siteConfig.profiles.length > 0 && (
                <section class="mt-10" aria-labelledby="profile-links">
                    <h2
                        id="profile-links"
                        class="text-muted dark:text-muted-dark px-2 text-sm font-bold tracking-widest uppercase"
                    >
                        Elsewhere
                    </h2>
                    <div class="mt-3 grid gap-3">
                        {siteConfig.profiles.map((profile) => (
                            <Card
                                href={profile.href}
                                rel={profile.external ? 'me noreferrer' : undefined}
                                padding="compact"
                                class="font-bold"
                            >
                                {profile.label}
                            </Card>
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <SiteFooter />
</BaseLayout>
